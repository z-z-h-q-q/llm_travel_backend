## Backend environment example
# Copy this file to `.env.backend` and fill the real keys. DO NOT commit `.env.backend`.

# Supabase (local CLI default URL may vary) - for production use your hosted supabase URL
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# 高德地图(Amap)
AMAP_KEY=your_amap_key_here

# Coza or LLM agent
COZE_API_BASE=https://api.coze.cn/v1/workflow/run
COZE_API_TOKEN=你的token
COZE_WORKFLOW_ID=your_coza_workflow_id_here
COZE_AGENT_ID=your_coza_agent_id_here


# Server-side speech recognition (deprecated)
# The project previously included example XUNFEI/iFlyTek keys here.
# Server-side audio transcription support has been removed. If you
# intend to re-enable a server-side ASR provider, document its keys
# here instead of XUNFEI, or instruct developers to use client-side
# Web Speech API for browser-based recognition.

# Optional: other settings
APP_ENV=development
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

AMAP_KEY=your_amap_key_here